# Server
PORT=5000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/market.db

# Angel One SmartAPI - NEVER commit real values
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Optional SmartAPI request-header overrides. Leave blank to auto-detect.
ANGEL_CLIENT_LOCAL_IP=
ANGEL_CLIENT_PUBLIC_IP=
ANGEL_MAC_ADDRESS=

# Market
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:15
INSTRUMENT_REFRESH_HOURS=24
QUOTE_BATCH_SIZE=50
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=3
